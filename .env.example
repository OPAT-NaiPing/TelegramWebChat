NODE_ENV=development

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

BASE_URL=https://web.telegram.org/a/

# 服务器账号登录：开启后不再走 Telegram 手机号/二维码登录，而是从旧服务拉取账号列表。
SERVER_ACCOUNT_LOGIN=1
SERVER_BASE_API=http://192.168.100.245:8889/
SERVER_BASE_WS=ws://192.168.100.245:8889/im/ws2?token=
# Telegram 官方 WSS Relay 地址；开发环境可配置为 ws://127.0.0.1:8890/tgws，生产留空则使用当前域名 /tgws。
SERVER_TGWS_RELAY_URL=ws://127.0.0.1:8890/tgws
SERVER_SKIP_TURNSTILE=1
SERVER_TURNSTILE_SITE_KEY=0x4AAAAAAA9uFUJZhOJ9F_kt
